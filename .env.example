# Local default is postgresql://productops:productops_local_dev@127.0.0.1:5432/product_ops
# On Vercel, use the two URIs from Supabase → Project Settings → Database → Connect.

# Transaction pooler (port 6543). Runtime on Vercel.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Session pooler (port 5432). Migrations. Same host, different port.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
