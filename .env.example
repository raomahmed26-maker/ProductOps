# Copy to .env and fill in. Not required locally if Postgres is on 127.0.0.1
# with the productops / product_ops role this repo defaults to.

# Vercel / Neon / Supabase: paste the connection string here.
# Prefer the pooled URL at runtime. Add sslmode=require if the host asks for TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional. Direct (non-pooled) URL for `prisma migrate`. Needed when DATABASE_URL
# goes through PgBouncer (Supabase transaction pooler on port 6543).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
